# Copiar a .env y completar con los valores del proyecto Supabase de este
# producto (el del SaaS, NO el que usa Euge en el sistema estable).

# Connection string de Postgres (Supabase > Project Settings > Database >
# Connection string > Session pooler). Si se omite, la app cae a SQLite
# local (sqlite:///./med.db) solo para desarrollo sin Supabase a mano.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Clave para firmar los JWT. Generar una propia por entorno, no reusar
# entre este SaaS y el sistema estable de Euge.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# API key de Resend (resend.com > API Keys) para el mail de reset de
# contraseña. Con el dominio de pruebas (onboarding@resend.dev) solo se
# puede mandar a la dirección de tu propia cuenta de Resend, hasta que
# se verifique un dominio propio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx